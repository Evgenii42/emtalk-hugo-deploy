  "schemas": {
    "page_view": {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "page_view"
        },
        "contract_version": {
          "const": "004"
        },
        "page_context": {
          "type": "string",
          "enum": [
            "home",
            "about",
            "articles_catalog",
            "article",
            "bret_landing",
            "dm_landing",
            "understand_guide",
            "tests_catalog",
            "assessment",
            "web_trial",
            "documents",
            "affirmations",
            "tapl",
            "news_catalog",
            "news_item"
          ]
        }
      },
      "required": [
        "event_name",
        "contract_version",
        "page_context"
      ],
      "additionalProperties": false
    },
    "emtalk_navigation": {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "emtalk_navigation"
        },
        "contract_version": {
          "const": "004"
        },
        "page_context": {
          "type": "string",
          "enum": [
            "home",
            "about",
            "articles_catalog",
            "article",
            "bret_landing",
            "dm_landing",
            "understand_guide",
            "tests_catalog",
            "assessment",
            "web_trial",
            "documents",
            "affirmations",
            "tapl",
            "news_catalog",
            "news_item"
          ]
        },
        "surface": {
          "type": "string",
          "enum": [
            "header",
            "footer",
            "home_choices",
            "public_cta",
            "article_card",
            "related_reading",
            "tool_exit",
            "catalog",
            "news_card",
            "news_cta",
            "ecosystem_step"
          ]
        },
        "destination_kind": {
          "type": "string",
          "enum": [
            "public_content",
            "app_landing",
            "trial_entry",
            "assessment_entry",
            "external_public",
            "documents"
          ]
        },
        "destination_product": {
          "type": "string",
          "enum": [
            "not_applicable",
            "bret",
            "dm",
            "tapl"
          ]
        }
      },
      "required": [
        "event_name",
        "contract_version",
        "page_context",
        "surface",
        "destination_kind",
        "destination_product"
      ],
      "additionalProperties": false
    },
    "emtalk_catalog_filter": {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "emtalk_catalog_filter"
        },
        "contract_version": {
          "const": "004"
        },
        "page_context": {
          "type": "string",
          "enum": [
            "articles_catalog",
            "tests_catalog",
            "news_catalog"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "filter",
            "reset"
          ]
        },
        "filter_group": {
          "type": "string",
          "enum": [
            "all",
            "project",
            "product",
            "reading"
          ]
        }
      },
      "required": [
        "event_name",
        "contract_version",
        "page_context",
        "action"
      ],
      "additionalProperties": false
    },
    "emtalk_article_action": {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "emtalk_article_action"
        },
        "contract_version": {
          "const": "004"
        },
        "page_context": {
          "type": "string",
          "enum": [
            "article"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "read_anchor",
            "listen_anchor",
            "contents_open"
          ]
        }
      },
      "required": [
        "event_name",
        "contract_version",
        "page_context",
        "action"
      ],
      "additionalProperties": false
    },
    "emtalk_audio_state": {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "emtalk_audio_state"
        },
        "contract_version": {
          "const": "004"
        },
        "page_context": {
          "type": "string",
          "enum": [
            "article"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "start",
            "resume",
            "pause",
            "ended",
            "error"
          ]
        },
        "error_kind": {
          "type": "string",
          "enum": [
            "not_applicable",
            "play_rejected",
            "load_failed",
            "timeout"
          ]
        }
      },
      "required": [
        "event_name",
        "contract_version",
        "page_context",
        "state",
        "error_kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "error"
              }
            }
          },
          "then": {
            "properties": {
              "error_kind": {
                "not": {
                  "const": "not_applicable"
                }
              }
            }
          },
          "else": {
            "properties": {
              "error_kind": {
                "const": "not_applicable"
              }
            }
          }
        }
      ]
    },
    "emtalk_store_click": {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "emtalk_store_click"
        },
        "contract_version": {
          "const": "004"
        },
        "page_context": {
          "type": "string",
          "enum": [
            "home",
            "about",
            "articles_catalog",
            "article",
            "bret_landing",
            "dm_landing",
            "understand_guide",
            "tests_catalog",
            "assessment",
            "web_trial",
            "documents",
            "affirmations",
            "tapl",
            "news_catalog",
            "news_item"
          ]
        },
        "product": {
          "type": "string",
          "enum": [
            "bret",
            "dm"
          ]
        },
        "store": {
          "const": "google_play"
        },
        "surface": {
          "type": "string",
          "enum": [
            "public_cta",
            "app_landing",
            "tool_exit"
          ]
        }
      },
      "required": [
        "event_name",
        "contract_version",
        "page_context",
        "product",
        "store",
        "surface"
      ],
      "additionalProperties": false
    },
    "emtalk_trial_state": {
      "type": "object",
      "properties": {
        "event_name": {
          "const": "emtalk_trial_state"
        },
        "contract_version": {
          "const": "004"
        },
        "page_context": {
          "type": "string",
          "enum": [
            "web_trial"
          ]
        },
        "product": {
          "type": "string",
          "enum": [
            "bret",
            "dm"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "requested",
            "started",
            "resumed",
            "progress",
            "completed",
            "stopped",
            "error"
          ]
        },
        "error_kind": {
          "type": "string",
          "enum": [
            "not_applicable",
            "initialization_failed",
            "runtime_failed",
            "required_capability_failed"
          ]
        }
      },
      "required": [
        "event_name",
        "contract_version",
        "page_context",
        "product",
        "state",
        "error_kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "error"
              }
            }
          },
          "then": {
            "properties": {
              "error_kind": {
                "not": {
                  "const": "not_applicable"
                }
              }
            }
          },
          "else": {
            "properties": {
              "error_kind": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "product": {
                "const": "bret"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "not": {
                  "const": "resumed"
                }
              }
            }
          }
        }
      ]
