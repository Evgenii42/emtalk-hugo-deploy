{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.emtalk.org/bret/meditation/background-video.schema.json",
  "title": "Optional BRET meditation backgroundVideo",
  "type": "object",
  "required": [
    "url",
    "mimeType",
    "codecs",
    "posterImageUrl",
    "width",
    "height",
    "durationMs",
    "bytes",
    "sha256"
  ],
  "properties": {
    "url": {
      "type": "string",
      "pattern": "^/(?!/)(?!.*(?:[\\\\\\s%?#]|(?:^|/)\\.{1,2}(?:/|$))).+\\.webm$",
      "description": "Origin-relative content-hashed WebM URL"
    },
    "mimeType": {
      "const": "video/webm"
    },
    "codecs": {
      "const": "vp9"
    },
    "posterImageUrl": {
      "type": "string",
      "pattern": "^/(?!/)(?!.*(?:[\\\\\\s%?#]|(?:^|/)\\.{1,2}(?:/|$))).+\\.webp$",
      "description": "Matching WebP still for this video"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3840
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3840
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000,
      "description": "One loop duration, independent of meditation audio duration"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20971520
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
