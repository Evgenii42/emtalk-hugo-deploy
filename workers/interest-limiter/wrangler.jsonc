{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "emtalk-interest-limiter-stage006",
  "main": "index.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "ratelimits": [
    {
      "name": "INTEREST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
